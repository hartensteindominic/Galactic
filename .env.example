# Galactic Trust banking mode.
# Keep this as demo until a regulated banking program is approved and configured.
BANKING_MODE=demo

# Partner mode configuration. Never commit real secrets.
# BANKING_PROVIDER_NAME=Approved Banking Platform
# BANKING_PARTNER_BANK_NAME=Approved FDIC-Insured Bank
# BANKING_PARTNER_DISCLOSURE=Banking services are provided by the identified partner bank, Member FDIC, subject to eligibility and the final approved program terms.
# BANKING_GATEWAY_BASE_URL=https://your-private-banking-gateway.example.com
# BANKING_GATEWAY_API_KEY=server-side-secret-only
# BANKING_PROGRAM_ID=your-program-id
# BANKING_AUTH_GATEWAY_SECRET=server-side-auth-signing-secret
#
# These are separate launch approvals. Credentials alone must never turn on live money.
# Set each to true only after the relevant review has actually been completed.
BANKING_COMPLIANCE_APPROVED=false
BANKING_DISCLOSURES_APPROVED=false
BANKING_ENABLE_LIVE_WRITES=false

# Provider SANDBOX configuration.
# Keep these completely separate from production banking credentials.
# The app compares sandbox vs production configuration internally and blocks sandbox networking
# if the gateway/API key/program ID are reused.
# BANKING_SANDBOX_PROVIDER_NAME=Approved Provider Sandbox
# BANKING_SANDBOX_GATEWAY_BASE_URL=https://sandbox-provider.example.com
# BANKING_SANDBOX_API_KEY=server-side-sandbox-secret-only
# BANKING_SANDBOX_PROGRAM_ID=your-sandbox-program-id
# BANKING_SANDBOX_WEBHOOK_SECRET=server-side-sandbox-webhook-secret
# BANKING_SANDBOX_OPERATOR_SECRET=at-least-32-random-characters-server-side-only
#
# This switch may enable PROVIDER-SANDBOX network calls only. It never enables production money movement.
BANKING_SANDBOX_PROVIDER_ENABLED=false

# Durable provider-sandbox database.
# Use a dedicated sandbox database/branch/cluster. Never reuse a production banking database URL.
# BANKING_SANDBOX_DATABASE_URL=postgresql://user:password@host:5432/galactic_sandbox
# SSL defaults to true. Set false only for an isolated local development database.
BANKING_SANDBOX_DATABASE_SSL=true
BANKING_SANDBOX_DATABASE_POOL_MAX=4
# A configured URL alone does not open a connection. This explicit gate must also be enabled.
BANKING_SANDBOX_DATABASE_ENABLED=false

# Crypto stays simulated unless an approved trading/custody provider is configured.
CRYPTO_MODE=demo
# CRYPTO_PROVIDER_NAME=Approved Crypto Provider
# CRYPTO_PARTNER_DISCLOSURE=Approved crypto services, custody, fee, eligibility, and risk disclosure text.
# CRYPTO_GATEWAY_BASE_URL=https://your-private-crypto-gateway.example.com
# CRYPTO_GATEWAY_API_KEY=server-side-secret-only
# CRYPTO_PROGRAM_ID=your-crypto-program-id
#
# Separate compliance + disclosure approvals are mandatory before the live trading flag can take effect.
CRYPTO_COMPLIANCE_APPROVED=false
CRYPTO_DISCLOSURES_APPROVED=false
CRYPTO_ENABLE_LIVE_TRADING=false

# Galactic x402 money receiver. This is public. Never put a private key here.
X402_PAY_TO=0x02f93c7547309ca50EEAB446DaEBE8ce8E694cBb
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_LICENSE_PRICE=$0.01
X402_LICENSE_USDC_ATOMIC=10000

# Base mainnet ownership lookup for the VoxelFlip NFT license catalog.
BASE_RPC_URL=https://mainnet.base.org
VOXELFLIP_CONTRACT_ADDRESS=0xa00758b05f96ef4409d97c3ffebb6794b2eafbde
VOXELFLIP_DEPLOYMENT_TX=0xc2f198a3730169bc5c61f0a1251301f16d40441c022b6cc30e9cf06bb8ea31bb
AI_LICENSE_LICENSOR_WALLET=0x02f93c7547309ca50EEAB446DaEBE8ce8E694cBb

# Optional speed boost: comma-separate known token IDs to skip event scanning.
# LICENSE_TOKEN_IDS=1,2,3
